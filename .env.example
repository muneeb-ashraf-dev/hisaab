# Copy to backend/.env or the repository-root .env and adjust for your machine.

# PostgreSQL on the standard local port, using the built-in superuser role.
DATABASE_URL=postgresql+psycopg://postgres:postgres123@127.0.0.1:5432/personal_finance
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres123@127.0.0.1:5432/personal_finance_test

# Shared Supabase alternative (Session Pooler). Keep TEST_DATABASE_URL local so
# tests never touch the shared database.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Per-machine manual backup target. When DATABASE_URL points at Supabase, this
# local database receives a restorable copy when the Backup now button is used.
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:postgres123@127.0.0.1:5432/personal_finance
BACKUP_KEEP=30
# Optional: directory containing pg_dump/pg_restore on this machine.
# PG_BIN=C:\Program Files\PostgreSQL\18\bin

APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BASELINE_DATE=2026-11-01
LOG_LEVEL=INFO

# Used by the Next.js server-side proxy (never exposed to the browser).
API_BASE_URL=http://127.0.0.1:8000

# Optional shared secret. Set the same value in the backend and frontend
# environments to require `Authorization: Bearer <token>` on every API request.
# Leave blank to run without authentication on a trusted local machine.
API_AUTH_TOKEN=
